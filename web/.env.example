# HLS stream URLs (defaults to production converter if unset)
# VITE_STREAM_URL=http://localhost:8888/cam/index.m3u8
# VITE_STREAM_URL_2=http://localhost:8888/cam2/index.m3u8

# Low-latency playback in hls.js (set to false for longer DVR-style buffer)
VITE_HLS_LOW_LATENCY=true

# Local dev: leave VITE_ONVIF_API_URL unset — Vite proxies /api to localhost:5245.
# Azure deploy sets this via terraform apply (terraform/web.tf).
# VITE_ONVIF_API_URL=https://your-onvif-api.example.com

# Tapo camera (required for pan/tilt controls on the site)
VITE_ONVIF_URI=http://192.168.0.79:2020/onvif/service
VITE_ONVIF_USER=your-camera-account
VITE_ONVIF_PASSWORD=your-password

# Camera 1 — Tapo host for SD-card recordings (defaults to hostname from VITE_ONVIF_URI)
# VITE_TAPO_HOST=192.168.0.79

# Camera 2 — set at least one of these for recordings on the second camera
VITE_ONVIF_URI_2=http://192.168.0.80:2020/onvif/service
# VITE_TAPO_HOST_2=192.168.0.80