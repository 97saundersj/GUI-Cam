# MediaMTX stream converter
MTX_HLSADDRESS=:8888
MTX_PATHS_CAM_SOURCE=rtsp://username:password@host:port/stream1
# Optional second stream (served at /cam2/index.m3u8)
# MTX_PATHS_CAM2_SOURCE=rtsp://username:password@host:port/stream1

# Low-latency HLS (also set these on Azure Container Apps if you deploy there)
MTX_HLSVARIANT=lowLatency
MTX_HLSSEGMENTDURATION=1s
MTX_HLSPARTDURATION=200ms
MTX_HLSALWAYSREMUX=yes

# Optional: API base URL (leave empty in dev — Vite proxies /api to localhost:5245)
# VITE_ONVIF_API_URL=https://your-onvif-api.example.com

# Tapo camera (required for pan/tilt controls on the site)
VITE_ONVIF_URI=http://192.168.0.79:2020/onvif/service
VITE_ONVIF_USER=your-camera-account
VITE_ONVIF_PASSWORD=your-password