@host = http://localhost:5245

### ONVIF details
POST {{host}}/api/onvif
Content-Type: application/json

{
  "onvifUri": "http://192.168.0.79:2020/onvif/service",
  "userName": "username",
  "password": "password"
}

### Tapo recordings (password in server config)
GET {{host}}/api/tapo/recordings?host=192.168.0.79&date=20260618

### Tapo recording playback (MPEG-TS, default)
GET {{host}}/api/tapo/playback?host=192.168.0.79&startTime=1718697600&endTime=1718698200&format=ts

### Tapo recording playback (MP4 fallback)
GET {{host}}/api/tapo/playback?host=192.168.0.79&startTime=1718697600&endTime=1718698200&format=mp4

### Tapo playback warmup
GET {{host}}/api/tapo/playback/warmup?host=192.168.0.79

### PTZ
POST {{host}}/api/onvif/ptz
Content-Type: application/json

{
  "command": "down",
  "onvifUri": "http://192.168.0.79:2020/onvif/service",
  "userName": "username",
  "password": "password"
}
